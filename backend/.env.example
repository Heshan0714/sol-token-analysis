PORT=4000
# Public Solana RPC has rate limits — for production get a free/paid key from
# Helius (https://helius.dev) or QuickNode and put your RPC URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Birdeye API key for richer market/holder cross-check data
# https://birdeye.so/  (free tier available)
BIRDEYE_API_KEY=
